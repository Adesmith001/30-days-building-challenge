{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git":{
    "deploymentEnabled": false
  },
  "devCommand": "vite --port $PORT",
  "rewrites": [
    { "source": "/s/:id", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/history/:id", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" }
  ]
}
